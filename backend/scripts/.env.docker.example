TZ=Asia/Shanghai

APP_NAME=couple-mini-backend
APP_VERSION=v0.0.1
APP_RUN_MODE=release
BACKEND_PORT=8080
PORT=8080
AUTH_TOKEN_SECRET=change_me_token_secret
AUTH_TOKEN_TTL_HOURS=168
WECHAT_APP_ID=your_wechat_miniprogram_appid
WECHAT_SECRET=your_wechat_miniprogram_secret

LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=logs
LOG_APP_FILE=app.log
LOG_ACCESS_FILE=access.log
LOG_ERROR_FILE=error.log
LOG_TO_STDOUT=true
LOG_SQL_LEVEL=warn
LOG_SQL_SLOW_MS=500
LOG_INCLUDE_SOURCE=false

ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_admin_password
ADMIN_TITLE=Couple Mini Admin
ADMIN_SAMPLE_INTERVAL_SEC=5
ADMIN_HISTORY_LIMIT=120

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=couple_mini
MYSQL_USER=couple
MYSQL_PASSWORD=couple_dev_password
MYSQL_ROOT_PASSWORD=couple_root_password
MYSQL_CREATE_DATABASE=true
MYSQL_AUTO_MIGRATE=true
MYSQL_AUTO_SEED=false
