page {
  min-height: 100%;
  color: #10213d;
  background: #fff4f7;
  font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", "Source Han Sans SC", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  background: transparent;
  text-align: center;
  overflow: hidden;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 44rpx 32rpx 140rpx;
  background: #fff4f7;
}

.page.white {
  background: #ffffff;
}

.status-row {
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  color: #0c1730;
  font-size: 22rpx;
  font-weight: 700;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-right: 150rpx;
  position: relative;
}

.page-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 42rpx;
  font-weight: 900;
  color: #0c1b37;
  min-width: 0;
}

.back-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0fc692;
  background: #eafff6;
  font-weight: 900;
}

.section-title {
  margin: 26rpx 0 18rpx;
  color: #7890b1;
  font-size: 26rpx;
  font-weight: 700;
}

.card {
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(38, 32, 46, 0.08);
}

.pill-tabs {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin: 18rpx 0 24rpx;
}

.pill-tab {
  min-width: 116rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8091ad;
  font-size: 28rpx;
  font-weight: 800;
}

.pill-tab.active-pink {
  color: #ffffff;
  background: #ff5a78;
  box-shadow: 0 8rpx 16rpx rgba(255, 70, 110, 0.2);
}

.pill-tab.active-purple {
  color: #ffffff;
  background: #9b6dff;
  box-shadow: 0 8rpx 16rpx rgba(139, 91, 255, 0.22);
}

.pill-tab.active-green {
  color: #ffffff;
  background: #08c994;
  box-shadow: 0 8rpx 16rpx rgba(8, 190, 142, 0.22);
}

.pill-tab.active-yellow {
  color: #ffffff;
  background: #ffbc09;
  box-shadow: 0 8rpx 16rpx rgba(255, 185, 0, 0.2);
}

.badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  color: inherit;
  background: rgba(121, 144, 176, 0.12);
  font-size: 20rpx;
}

.tag {
  min-height: 34rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  display: inline-flex;
  align-items: center;
  color: #8664ff;
  background: #f1ebff;
  font-size: 20rpx;
  font-weight: 700;
}

.tag.red {
  color: #ff486e;
  background: #fff0f3;
}

.tag.green {
  color: #02af82;
  background: #e8fff5;
}

.tag.yellow {
  color: #f09a00;
  background: #fff8df;
}

.primary-btn {
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #ff5a78;
  font-size: 28rpx;
  font-weight: 900;
}

.soft-btn {
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #865bff;
  background: #f2efff;
  font-size: 28rpx;
  font-weight: 900;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(135deg, #33364a, #ff6c94);
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(55, 44, 62, 0.18);
  font-size: 38rpx;
}

.avatar.dark {
  background: linear-gradient(135deg, #181c25, #644a3f);
}

.safe-bottom {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
