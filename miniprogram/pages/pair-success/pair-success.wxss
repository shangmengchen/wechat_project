.success-page {
  min-height: 100vh;
  padding: 48rpx 48rpx 42rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.8) 0, rgba(255, 255, 255, 0) 34%),
    linear-gradient(160deg, #fff8f6 0%, #ffeef3 55%, #ffe1e7 100%);
}

.success-card {
  margin-top: 96rpx;
  padding: 64rpx 40rpx 44rpx;
  border-radius: 36rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 44rpx rgba(106, 58, 76, 0.14);
}

.success-mark {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 30rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7695 0%, #ff4f72 100%);
  box-shadow: 0 14rpx 32rpx rgba(255, 83, 118, 0.28);
  font-size: 64rpx;
  font-weight: 900;
}

.success-title {
  color: #112142;
  font-size: 48rpx;
  font-weight: 900;
}

.success-subtitle {
  margin-top: 16rpx;
  color: #7488a7;
  font-size: 26rpx;
}

.success-pair {
  margin: 48rpx 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9ab0, #ff5e83);
  border: 6rpx solid #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(82, 43, 62, 0.15);
  font-size: 30rpx;
  font-weight: 900;
}

.success-avatar.dark {
  background: linear-gradient(135deg, #223154, #7f5b72);
}

.success-line {
  width: 120rpx;
  height: 8rpx;
  margin: 0 -4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffb3c1, #8edfc9);
}

.success-note {
  color: #6e7f9c;
  font-size: 25rpx;
  line-height: 1.7;
}

.success-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 42rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6d92 0%, #ff5578 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 96, 136, 0.24);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.success-btn[disabled] {
  opacity: 0.58;
  box-shadow: none;
}
